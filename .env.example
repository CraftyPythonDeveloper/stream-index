# stream-index environment configuration
# Copy this file to .env and adjust values before running

# --- Server ---
ADDON_HOST=0.0.0.0
ADDON_PORT=7000

# Set this to your local IP for Android TV access (e.g. http://192.168.1.100:7000)
ADDON_PUBLIC_URL=

# --- Logging ---
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=info

# --- HTTP client ---
REQUEST_TIMEOUT=20.0
# USER_AGENT=Mozilla/5.0 ...

# --- HDHub4u ---
# Leave blank to auto-fetch the live domain at startup
HDHUB4U_BASE_URL=

# --- TMDB metadata ---
# Default uses the Cloudflare Workers proxy included in the reference implementation
TMDB_API_KEY=1865f43a0549ca50d341dd9ab8b29f49
TMDB_BASE_URL=https://wild-surf-4a0d.phisher1.workers.dev
# To use the official TMDB API directly, get a key at https://www.themoviedb.org/
# and set TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Addon identity ---
ADDON_ID=community.stremio.stream-index
ADDON_NAME=Stream Index
ADDON_VERSION=0.1.0
ADDON_DESCRIPTION=Search HDHub4u for movies and TV shows.
